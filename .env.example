# HuggingFace token — required for gated models (e.g. llama3-8b)
# Create at https://huggingface.co/settings/tokens (read access is enough)
# HF_TOKEN=hf_...

# Optional overrides (see README configuration reference)
# INFERENCE_X_DEFAULT_MODEL=llama3-8b
# INFERENCE_X_LOADED_MODELS=qwen2.5-0.5b,tinyllama-chat
# INFERENCE_X_HOST=127.0.0.1
